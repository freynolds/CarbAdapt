# Local defaults only. Copy to the repo root before the first run:
#   cp .env.example .env
# Prisma commands load it from packages/db. Do not point the Next.js app at it:
# it contains the database URL, which must not be bundled into the browser.
#
# Native MySQL 8.x on 127.0.0.1:3306. Create the account first:
#   mysql -u root -p < packages/db/sql/create-local-user.sql
# MySQL 8 uses caching_sha2_password by default (8.4 turns
# mysql_native_password off). Prisma 6 speaks that plugin, so this URL has
# no auth parameter. 127.0.0.1 is TCP and matches 'carbadapt'@'127.0.0.1'
# (the name localhost would use the socket account instead).

DATABASE_URL="mysql://carbadapt:carbadapt@127.0.0.1:3306/carbadapt"

# Read only by the optional Docker Compose path (npm run db:up).
MYSQL_ROOT_PASSWORD=carbadapt
MYSQL_DATABASE=carbadapt
MYSQL_USER=carbadapt
MYSQL_PASSWORD=carbadapt

# mock | staging | production. Only mock finishes booting today.
APP_ENV=mock
API_HOST=127.0.0.1
API_PORT=4050

# Next rewrite target for /backend. scripts/dev.mjs forwards this to the web
# process. next.config.ts falls back to the same URL when it is unset.
API_URL=http://127.0.0.1:4050

# Read by apps/web only if you place it in apps/web/.env.local.
# Browser calls use /backend. This is the absolute fallback in apps/web/lib/api.ts.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4050

# Magic-link page the email points at. The API appends ?token=
# Leave empty to use http://127.0.0.1:3050/auth/magic
MAGIC_LINK_URL_BASE=

# Worker poll interval in milliseconds. Operations knob, not a product push time.
# Empty uses 5000.
WORKER_POLL_MS=

# Token storage seal. Mock stores the literal "mock:local" and does not require this.
# Generate 32 bytes of hex for a real seal. The seal itself is not implemented yet.
TOKEN_ENCRYPTION_KEY=

# Web Push (channel still open; mock delivery logs the copy key).
# Generate a pair with `npx web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Strava — https://www.strava.com/settings/api
# Create an API application. Redirect URI must match STRAVA_REDIRECT_URI.
# Webhook verify token is any string you choose; Strava echoes it on the subscription handshake.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_REDIRECT_URI=
STRAVA_AUTHORIZE_URL=
STRAVA_TOKEN_URL=
STRAVA_API_BASE=

# TrainingPeaks — https://www.trainingpeaks.com/developer/ (partner API access)
# TRAININGPEAKS_WEBHOOK is not a public product. Leave it empty until TrainingPeaks
# gives you a webhook subscription. The live adapter then returns NotConfigured.
TRAININGPEAKS_CLIENT_ID=
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_REDIRECT_URI=
TRAININGPEAKS_AUTHORIZE_URL=
TRAININGPEAKS_TOKEN_URL=
TRAININGPEAKS_API_BASE=

# Garmin Connect Developer Program — https://developer.garmin.com/gc-developer-program/
# Stays off until GARMIN_ENABLED=true. Connect still returns ProviderDisabled when this is not "true".
GARMIN_ENABLED=
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_REDIRECT_URI=
GARMIN_AUTHORIZE_URL=
GARMIN_TOKEN_URL=
GARMIN_API_BASE=
