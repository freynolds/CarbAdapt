{
  "name": "carbadapt",
  "version": "0.0.0",
  "private": true,
  "description": "CarbAdapt monorepo: endurance fueling and gut training.",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/worker",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @carbadapt/web",
    "dev:api": "npm run dev -w @carbadapt/api",
    "db:up": "echo '[optional docker] start MySQL. Native MySQL is the default; see README.' && docker compose up -d",
    "db:down": "echo '[optional docker] stop the Compose MySQL. This does not stop a native server.' && docker compose down",
    "db:logs": "echo '[optional docker] Compose MySQL logs.' && docker compose logs -f mysql",
    "db:generate": "npm run generate -w @carbadapt/db",
    "db:validate": "npm run validate -w @carbadapt/db",
    "db:migrate": "npm run migrate -w @carbadapt/db",
    "db:seed": "npm run seed -w @carbadapt/db",
    "db:reset": "npm run reset -w @carbadapt/db",
    "postinstall": "npm run db:generate",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "prettier": "./packages/config/prettier.json",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
