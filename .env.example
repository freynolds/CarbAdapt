# Local defaults only. Copy to the repo root before the first run:
#   cp .env.example .env
# Prisma commands load it from packages/db. Do not point the Next.js app at it:
# it contains the database URL, which must not be bundled into the browser.
#
# Native MySQL 8.x on 127.0.0.1:3306. Create the account first:
#   mysql -u root -p < packages/db/sql/create-local-user.sql
# MySQL 8 uses caching_sha2_password by default (8.4 turns
# mysql_native_password off). Prisma 6 speaks that plugin, so this URL has
# no auth parameter. 127.0.0.1 is TCP and matches 'carbadapt'@'127.0.0.1'
# (the name localhost would use the socket account instead).

DATABASE_URL="mysql://carbadapt:carbadapt@127.0.0.1:3306/carbadapt"

# Read only by the optional Docker Compose path (npm run db:up).
MYSQL_ROOT_PASSWORD=carbadapt
MYSQL_DATABASE=carbadapt
MYSQL_USER=carbadapt
MYSQL_PASSWORD=carbadapt

# mock | staging | production. Only mock finishes booting today.
APP_ENV=mock
API_HOST=127.0.0.1
API_PORT=4050

# Next rewrite target for /backend. scripts/dev.mjs forwards this to the web
# process. next.config.ts falls back to the same URL when it is unset.
API_URL=http://127.0.0.1:4050

# Read by apps/web only if you place it in apps/web/.env.local.
# Browser calls use /backend. This is the absolute fallback in apps/web/lib/api.ts.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4050
