{
  "name": "@carbadapt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../../.env --import tsx --test --test-concurrency=1 src/http/app.test.ts src/modules/*/*.test.ts"
  },
  "dependencies": {
    "@carbadapt/contracts": "*",
    "@carbadapt/db": "*",
    "@prisma/client": "~6.19.2",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
