{
  "name": "@carbadapt/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src prisma/seed.ts"
  },
  "dependencies": {
    "@carbadapt/fixtures": "workspace:*",
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "dotenv-cli": "^8.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
